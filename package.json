{
  "name": "pb-law",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "bun deploy/local-server.mjs dev",
    "build": "bun run build:api && bun run build:ui",
    "start": "bun deploy/local-server.mjs production",
    "lint": "eslint",
    "test": "bun test ./tests/*.test.ts",
    "test:api-runtime": "bun test ./tests/production/*.test.ts",
    "test:setup": "playwright install --with-deps chromium",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:e2e:argument-viewer-dark-theme": "playwright test tests/playwright/argument-viewer-dark-theme.spec.ts",
    "dev:api": "bun --bun run next dev --port 3001",
    "build:api": "bun deploy/export-public-content.ts && next build && bun deploy/package-standalone.mjs && bun deploy/verify-event-hubs.mjs && bun run test:api-runtime",
    "build:ui": "bun deploy/export-public-content.ts && vite build && bun deploy/package-static.mjs",
    "start:api": "API_SERVER_PATH=build/standalone/server.js bun deploy/keyvault-start.mjs"
  },
  "dependencies": {
    "@azure/cosmos": "^4.6.0",
    "@azure/data-tables": "^13.3.2",
    "@azure/event-hubs": "^6.0.0",
    "@azure/identity": "^4.13.0",
    "@azure/monitor-opentelemetry": "^1.19.0",
    "@azure/monitor-opentelemetry-exporter": "^1.0.0-beta.32",
    "@azure/msal-browser": "^4.30.0",
    "@azure/msal-node": "^5.2.0",
    "@azure/msal-react": "^3.0.20",
    "@azure/storage-blob": "^12.31.0",
    "@azure/web-pubsub": "^1.2.0",
    "@azure/web-pubsub-client": "^1.0.2",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@microsoft/applicationinsights-web": "^3.3.10",
    "@opentelemetry/api": "^1.9.0",
    "@tanstack/react-form": "^1.28.6",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "file-saver": "^2.0.5",
    "jose": "^6.1.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.553.0",
    "next": "^16.4.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-roast": "^1.4.3",
    "react-router-dom": "^7.9.5",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.1.12"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0"
  }
}
