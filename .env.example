# Defaults for local UI tests. Use your Azure application's values for real login.
NEXT_PUBLIC_AAD_TENANT_ID=e2e-tenant
NEXT_PUBLIC_AAD_CLIENT_ID=e2e-client
NEXT_PUBLIC_AAD_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_AAD_API_SCOPE=openid,profile
NEXT_PUBLIC_AAD_ATTORNEY_EXTENSION=extension_example_IsAttorney
AZURE_AD_AUDIENCE=e2e-audience

# Public support address, including SOC 2 report requests. Set before building.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.test

# Keep local telemetry disabled.
APPLICATIONINSIGHTS_DISABLED=true
NEXT_PUBLIC_APPINSIGHTS_CONNECTION_STRING=
LEGAL_DOCUMENT_ARCHIVE_PATH=archives/TermsAndAgreements.zip

# Required only for live SharePoint integration; use your deployment's hostname.
# SHAREPOINT_HOST=
# AZURE_SHAREPOINT_READ_SCOPES=

# For live integration testing, add the backend settings listed in README.md.
# STORAGE_ACCOUNT_NAME=
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential
